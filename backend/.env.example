PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pos_database
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL=false
DB_POOL_MAX=10
